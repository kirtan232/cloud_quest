rules_version = '2';

// Cloud Quest security rules (client requests only).
// The Admin SDK used by Cloud Functions bypasses these rules, so the
// completeToday / askQuestCoach functions enforce their own auth checks.
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared, read-only challenge content. Written only by the seed script.
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Private learner progress. A learner may read only their own record;
    // reward fields (points, badgeId, completed) are written only by the
    // trusted completeToday Cloud Function.
    match /users/{userId}/progress/{progressId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if false;
    }

    // Optional push-token storage (not used in the classwork); fully locked.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if false;
    }
  }
}
