{
  "name": "functions",
  "description": "Cloud Quest trusted backend (reward callable + Quest Coach)",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only auth,firestore,functions --import=../emulator-data --export-on-exit",
    "seed": "node seed.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "private": true,
  "dependencies": {
    "@genkit-ai/google-genai": "^1.44.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "genkit": "^1.44.0"
  }
}
